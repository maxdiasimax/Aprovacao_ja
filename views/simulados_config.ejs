<%- include('partials/header') %>

<div style="text-align: center; margin-bottom: 30px;">
    <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 1px;">Configurar Simulado</span>
    <h2 style="color: var(--primary-color); margin-top: 5px;">Prepare-se para o sucesso</h2>
</div>

<div class="card" style="max-width: 800px; margin: 0 auto 30px auto;">
    <form action="/simulados/iniciar" method="POST">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 25px;">
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 8px;">Disciplina</label>
                <select name="disciplina" class="form-control">
                    <option value="">Todas</option>
                    <% disciplinas.forEach(d => { %>
                        <option value="<%= d.disciplina %>"><%= d.disciplina %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 8px;">Banca</label>
                <select name="banca" class="form-control">
                    <option value="">Todas</option>
                    <% bancas.forEach(b => { %>
                        <option value="<%= b.banca %>"><%= b.banca %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 8px;">Quantidade de Questões</label>
                <select name="qtd" class="form-control">
                    <option value="10">10 Questões</option>
                    <option value="20" selected>20 Questões</option>
                    <option value="50">50 Questões</option>
                    <option value="100">100 Questões</option>
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 8px;">Tempo do Simulado</label>
                <select name="tempo" class="form-control">
                    <option value="30">30 Minutos</option>
                    <option value="60" selected>60 Minutos</option>
                    <option value="120">2 Horas</option>
                    <option value="180">3 Horas</option>
                    <option value="0">Sem Limite</option>
                </select>
            </div>
        </div>

        <div style="text-align: center; margin-top: 20px;">
            <button type="submit" class="btn btn-primary" style="padding: 15px 40px; font-size: 1rem; font-weight: 700; background: linear-gradient(135deg, var(--primary-color), #2563eb); border: none; box-shadow: 0 4px 6px rgba(37, 99, 235, 0.2);">
                INICIAR SIMULADO
            </button>
        </div>
    </form>
</div>

<% if (historico && historico.length > 0) { %>
    <div style="max-width: 800px; margin: 40px auto 0 auto;">
        <h3 style="margin-bottom: 20px; color: var(--text-main); font-size: 1.1rem;">Últimos Simulados Realizados</h3>
        <div class="card" style="padding: 0; overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead style="background: #f8fafc; border-bottom: 1px solid var(--border);">
                    <tr>
                        <th style="padding: 12px 20px; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Data</th>
                        <th style="padding: 12px 20px; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Filtros</th>
                        <th style="padding: 12px 20px; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; text-align: center;">Desempenho</th>
                        <th style="padding: 12px 20px; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; text-align: right;">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    <% historico.forEach(s => { %>
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 15px 20px; font-size: 0.9rem;">
                                <%= new Date(s.data).toLocaleDateString('pt-BR') %>
                            </td>
                            <td style="padding: 15px 20px; font-size: 0.9rem;">
                                <div style="font-weight: 600;"><%= s.disciplina %></div>
                                <div style="font-size: 0.8rem; color: var(--text-muted);"><%= s.banca %></div>
                            </td>
                            <td style="padding: 15px 20px; text-align: center;">
                                <span style="
                                    background: <%= (s.acertos / s.total_questoes) >= 0.7 ? '#ecfdf5' : '#fef2f2' %>;
                                    color: <%= (s.acertos / s.total_questoes) >= 0.7 ? 'var(--success)' : 'var(--danger)' %>;
                                    padding: 4px 10px;
                                    border-radius: 20px;
                                    font-size: 0.85rem;
                                    font-weight: 700;
                                ">
                                    <%= s.acertos %> / <%= s.total_questoes %>
                                </span>
                            </td>
                            <td style="padding: 15px 20px; text-align: right;">
                                <a href="/simulados/resultado/<%= s.id %>" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.8rem; text-decoration: none;">Ver Resultado</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>

<%- include('partials/footer') %>
