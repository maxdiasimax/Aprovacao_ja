<%- include('partials/header') %>

<div style="text-align: center; margin-bottom: 40px;">
    <span style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; letter-spacing: 1px;">Resultado do Simulado</span>
    <h2 style="color: var(--primary-color); margin-top: 5px;">Seu Desempenho</h2>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px;">
    <div class="card" style="text-align: center; border-top: 4px solid var(--primary-color);">
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 10px;">Acertos</div>
        <div style="font-size: 2.5rem; font-weight: 800; color: var(--text-main);">
            <%= resultado.acertos %> <span style="font-size: 1.2rem; color: var(--text-muted); font-weight: 500;">/ <%= resultado.total_questoes %></span>
        </div>
        <div style="margin-top: 5px; font-weight: 700; color: <%= (resultado.acertos / resultado.total_questoes) >= 0.7 ? 'var(--success)' : 'var(--danger)' %>">
            <%= ((resultado.acertos / resultado.total_questoes) * 100).toFixed(1) %>% de Aproveitamento
        </div>
    </div>

    <div class="card" style="text-align: center; border-top: 4px solid var(--secondary-color);">
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 10px;">Tempo Total</div>
        <div style="font-size: 2.5rem; font-weight: 800; color: var(--text-main);">
            <% 
                const m = Math.floor(resultado.tempo_gasto / 60);
                const s = resultado.tempo_gasto % 60;
            %>
            <%= m.toString().padStart(2, '0') %>:<%= s.toString().padStart(2, '0') %>
        </div>
        <div style="margin-top: 5px; font-weight: 600; color: var(--text-muted);">
            Tempo Gasto
        </div>
    </div>

    <div class="card" style="text-align: center; border-top: 4px solid var(--success);">
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 10px;">Média por Questão</div>
        <div style="font-size: 2.5rem; font-weight: 800; color: var(--text-main);">
            <%= (resultado.tempo_gasto / resultado.total_questoes).toFixed(0) %>s
        </div>
        <div style="margin-top: 5px; font-weight: 600; color: var(--text-muted);">
            Segundos
        </div>
    </div>
</div>

<div style="margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center;">
    <h3 style="color: var(--text-main);">Revisão das Questões</h3>
    <a href="/simulados" class="btn btn-primary">Novo Simulado</a>
</div>

<div style="display: flex; flex-direction: column; gap: 24px;">
    <% resultado.detalhes.forEach((q, index) => { %>
        <div class="card" style="border-left: 6px solid <%= q.correta ? 'var(--success)' : 'var(--danger)' %>;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted);">QUESTÃO <%= index + 1 %></span>
                <span style="
                    background: <%= q.correta ? '#ecfdf5' : '#fef2f2' %>;
                    color: <%= q.correta ? 'var(--success)' : 'var(--danger)' %>;
                    padding: 4px 12px;
                    border-radius: 20px;
                    font-size: 0.75rem;
                    font-weight: 800;
                    text-transform: uppercase;
                ">
                    <%= q.correta ? 'Acerto' : (q.resposta_user ? 'Erro' : 'Não Respondida') %>
                </span>
            </div>

            <div style="font-size: 1rem; margin-bottom: 20px; line-height: 1.6;">
                <%= q.pergunta %>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px;">
                <% if (q.opcoes) { %>
                    <% Object.entries(q.opcoes).forEach(([label, text]) => { %>
                        <% if (text) { %>
                            <div style="
                                padding: 12px 15px; 
                                border: 1px solid <%= label === q.resposta_correta ? 'var(--success)' : (label === q.resposta_user ? 'var(--danger)' : 'var(--border)') %>; 
                                border-radius: 8px; 
                                display: flex;
                                gap: 12px;
                                background: <%= label === q.resposta_correta ? '#f0fdf4' : (label === q.resposta_user ? '#fef2f2' : 'white') %>;
                            ">
                                <span style="
                                    background: <%= label === q.resposta_correta ? 'var(--success)' : (label === q.resposta_user ? 'var(--danger)' : '#f1f5f9') %>;
                                    color: <%= (label === q.resposta_correta || label === q.resposta_user) ? 'white' : 'var(--text-muted)' %>;
                                    width: 24px; 
                                    height: 24px; 
                                    display: flex; 
                                    align-items: center; 
                                    justify-content: center; 
                                    border-radius: 50%; 
                                    font-weight: bold; 
                                    font-size: 0.75rem;
                                    flex-shrink: 0;
                                "><%= label %></span>
                                <div style="font-size: 0.9rem; color: var(--text-main);"><%= text %></div>
                            </div>
                        <% } %>
                    <% }) %>
                <% } %>
            </div>

            <div style="background: #f8fafc; padding: 20px; border-radius: 12px; border: 1px solid var(--border);">
                <h4 style="margin-bottom: 8px; color: var(--primary-color); font-size: 0.9rem;">Explicação</h4>
                <div style="font-size: 0.85rem; line-height: 1.5; color: var(--text-main);">
                    <%= q.explicacao %>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<div style="text-align: center; margin-top: 40px; margin-bottom: 40px;">
    <a href="/dashboard" class="btn btn-secondary" style="padding: 12px 30px; text-decoration: none;">Ir para Início</a>
    <a href="/simulados" class="btn btn-primary" style="padding: 12px 30px; margin-left: 15px; text-decoration: none;">Novo Simulado</a>
</div>

<%- include('partials/footer') %>
